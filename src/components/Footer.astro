---
---
<footer>
  <div class="footer-inner">
    <div class="footer-top">
      
      <!-- Brand column -->
      <div class="footer-brand">
        <a href="/" class="nav-logo" aria-label="KasaRápida Homepage">
          <svg class="brand-logo-svg" viewBox="0 0 200 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="logoIconGradFooter" x1="0" y1="0" x2="36" y2="36" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#60a5fa"/>
                <stop offset="50%" stop-color="#2563eb"/>
                <stop offset="100%" stop-color="#1d4ed8"/>
              </linearGradient>
              <linearGradient id="logoTextGradFooter" x1="85" y1="0" x2="200" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#ffffff"/>
                <stop offset="100%" stop-color="#93c5fd"/>
              </linearGradient>
              <linearGradient id="boltGradFooter" x1="0" y1="36" x2="36" y2="0" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#93c5fd"/>
                <stop offset="100%" stop-color="#60a5fa"/>
              </linearGradient>
            </defs>

            <!-- ICON PART (Left) -->
            <circle cx="20" cy="24" r="18" fill="#2563eb" fill-opacity="0.08" />
            <path d="M 9 19 L 20 10 L 31 19 L 31 34 C 31 35.5 30 36.5 28.5 36.5 L 11.5 36.5 C 10 36.5 9 35.5 9 34 Z" fill="#0d111a" stroke="url(#logoIconGradFooter)" stroke-width="2.5" stroke-linejoin="round"/>
            <line x1="20" y1="10" x2="20" y2="36.5" stroke="url(#logoIconGradFooter)" stroke-dasharray="1.5,1.5" stroke-width="1" />
            <line x1="9" y1="19" x2="31" y2="19" stroke="url(#logoIconGradFooter)" stroke-width="1" stroke-opacity="0.5" />
            <path d="M 21.5 14 L 27.5 14 L 21 23 L 26.5 23 L 18 34.5 L 20.5 25.5 L 16.5 25.5 Z" fill="url(#boltGradFooter)" />
            <circle cx="20" cy="10" r="2.5" fill="#60a5fa" stroke="#ffffff" stroke-width="1"/>

            <!-- TYPOGRAPHY PART (Right) -->
            <text x="44" y="29" font-family="'DM Sans', sans-serif" font-weight="800" font-size="18" fill="url(#logoTextGradFooter)" letter-spacing="0.5">Kasa</text>
            <text x="86" y="29" font-family="'Bebas Neue', sans-serif" font-weight="700" font-size="22" fill="#2563eb" letter-spacing="1">RÁPIDA</text>
          </svg>
        </a>
        <p>Soluções residenciais e comerciais expansíveis de última geração para Portugal. Transporta, abre, habita. Simples e requintado.</p>
        <div class="footer-social">
          <a href="#" class="social-btn" aria-label="Instagram">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="#" class="social-btn" aria-label="Facebook">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
          <a href="#" class="social-btn" aria-label="YouTube">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
          </a>
          <a href="#" class="social-btn" aria-label="WhatsApp">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          </a>
        </div>
      </div>

      <!-- Links column 1 -->
      <div class="footer-col">
        <h4>Empresa</h4>
        <ul>
          <li><a href="/#sobre">Sobre Nós</a></li>
          <li><a href="/#como">Como Funciona</a></li>
          <li><a href="/#modelos">Os Nossos Modelos</a></li>
          <li><a href="/#orcamento">Pedir Orçamento</a></li>
          <li><a href="/#orcamento">Contacto Direto</a></li>
        </ul>
      </div>

      <!-- Links column 2 -->
      <div class="footer-col">
        <h4>Habitações</h4>
        <ul>
          <li><a href="/#modelos">Compact 20 · 32m²</a></li>
          <li><a href="/#modelos">Duplex 40 · 68m²</a></li>
          <li><a href="/#modelos">Villa 60 · 96m²</a></li>
          <li><a href="/#modelos">Soluções Customizadas</a></li>
          <li><a href="/#modelos">Modelos Comerciais</a></li>
        </ul>
      </div>

      <!-- Links column 3 -->
      <div class="footer-col">
        <h4>Recursos</h4>
        <ul>
          <li><a href="/#faq">FAQ Geral</a></li>
          <li><a href="/#sobre">Licenciamento em Portugal</a></li>
          <li><a href="/#vantagens">Sustentabilidade</a></li>
          <li><a href="/#como">Processo de Montagem</a></li>
          <li><a href="/#orcamento">Pedido de Catálogo PDF</a></li>
        </ul>
      </div>
      
    </div>

    <!-- Bottom footer -->
    <div class="footer-bottom">
      <p>© 2026 KasaRápida · Todos os direitos reservados · Portugal</p>
      <div class="footer-bottom-links">
        <a href="#">Privacidade</a>
        <a href="#">Termos e Condições</a>
        <a href="#">Configuração de Cookies</a>
      </div>
    </div>
  </div>
</footer>


