---
---
<footer>
  <div class="footer-inner">
    <div class="footer-simple-grid">
      <!-- Left side: Logo & Brand Short Desc -->
      <div class="footer-brand-simple">
        <a href="/" class="nav-logo" aria-label="KasaRápida Homepage">
          <svg class="brand-logo-svg" viewBox="0 0 200 48" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <!-- Premium rich-dark circular background gradient -->
              <linearGradient id="bgGradFooter" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#0a0e17" />
                <stop offset="100%" stop-color="#030509" />
              </linearGradient>

              <!-- Ultra-vibrant tech-blue gradient for the logo mark -->
              <linearGradient id="krGradFooter" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#60a5fa" />
                <stop offset="50%" stop-color="#2563eb" />
                <stop offset="100%" stop-color="#1d4ed8" />
              </linearGradient>
              
              <!-- Neon blue glow gradient -->
              <linearGradient id="glowGradFooter" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#93c5fd" />
                <stop offset="100%" stop-color="#3b82f6" />
              </linearGradient>
            </defs>

            <!-- ICON: Sleek geometric house & lightning hybrid mark from favicon inside circular badge -->
            <g transform="translate(6, 6) scale(0.36)">
              <!-- Circular background badge - extremely modern and premium -->
              <circle cx="50" cy="50" r="48" fill="url(#bgGradFooter)" stroke="#2563eb" stroke-width="2.5" stroke-opacity="0.5" />
              
              <!-- Sleek geometric house & lightning hybrid mark -->
              <!-- A sharp, clean roof shape outlined in vibrant tech-blue gradient -->
              <path d="M 22 45 L 50 18 L 78 45" stroke="url(#krGradFooter)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
              
              <!-- Bolder house body representing a modular shipping container -->
              <rect x="27" y="45" width="46" height="34" rx="6" fill="#0d131f" stroke="url(#krGradFooter)" stroke-width="6" />

              <!-- Speed lightning bolt ("Rápida" essence) in high-contrast neon blue, cutting through the house beautifully -->
              <path d="M 52 28 L 64 28 L 50 48 L 60 48 L 40 74 L 46 53 L 36 53 Z" fill="url(#glowGradFooter)" />
            </g>

            <!-- TYPOGRAPHY: Elegant brand name -->
            <text x="48" y="30" font-family="'DM Sans', sans-serif" font-weight="800" font-size="20" fill="#ffffff" letter-spacing="0.5">Kasa<tspan fill="#2563eb">Rápida</tspan></text>
          </svg>
        </a>
        <p class="footer-desc-simple">Soluções modulares expansíveis de última geração em Portugal. A sua casa a um preço justo e pronta a habitar.</p>
      </div>

      <!-- Right side: Clean navigation row and Socials -->
      <div class="footer-nav-simple">
        <ul class="footer-links-simple">
          <li><a href="/o-que-e">O Que É</a></li>
          <li><a href="/vantagens">Vantagens</a></li>
          <li><a href="/como-funciona">Como Funciona</a></li>
          <li><a href="/faq">FAQ</a></li>
        </ul>

        <div class="footer-social-simple">
          <a href="#" class="social-btn" aria-label="Instagram">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="#" class="social-btn" aria-label="Facebook">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
          <a href="#" class="social-btn" aria-label="YouTube">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 1.94-2 29 29 0 0 0-.46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
          </a>
          <a href="#" class="social-btn" aria-label="WhatsApp">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom footer -->
    <div class="footer-bottom-simple" style="justify-content: center; text-align: center;">
      <p>© 2026 KasaRápida · Todos os direitos reservados · Portugal</p>
    </div>
  </div>
</footer>
