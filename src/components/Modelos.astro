---
---
<section class="modelos" id="modelos">
  <div class="modelos-inner">
    
    <div class="modelos-header reveal">
      <div>
        <div class="section-label">Habitação de Assinatura</div>
        <h2 class="section-title">O Nosso<br>Modelo</h2>
      </div>
      <p class="section-body">
        Conheça a nossa habitação expansível inteligente. Um design único de 32 m² de área útil, perfeitamente otimizado para maximizar o conforto, a luz natural e a versatilidade.
      </p>
    </div>

    <div class="modelos-grid" style="display: flex; justify-content: center; width: 100%;">
      
      <!-- Modelo 1: Compact 20 -->
      <div class="modelo-card featured reveal" style="max-width: 480px; width: 100%;">
        <div class="modelo-thumb">
          <div class="modelo-badge">Modelo de Assinatura</div>
          
          <div class="modelo-slider-container">
            <a href="/modelos/compact20" class="modelo-thumb-link" style="display:block; text-decoration:none; height: 100%;">
              <div class="modelo-slides">
                <div class="modelo-slide active" data-index="0" data-price="Desde €22.000">
                  <img src="/1.jpeg" alt="KasaRápida Compact 20 — T0" class="modelo-img" />
                </div>
                <div class="modelo-slide" data-index="1" data-price="Desde €26.500">
                  <img src="/2.jpeg" alt="KasaRápida Compact 20 — T1" class="modelo-img" />
                </div>
                <div class="modelo-slide" data-index="2" data-price="Desde €31.000">
                  <img src="/3.jpeg" alt="KasaRápida Compact 20 — T2" class="modelo-img" />
                </div>
                <div class="modelo-slide" data-index="3" data-price="Desde €36.000">
                  <img src="/t3.jpeg" alt="KasaRápida Compact 20 — T3" class="modelo-img" />
                </div>
              </div>
            </a>

            <!-- Slider Navigation Arrows -->
            <button class="modelo-arrow prev" aria-label="Anterior" type="button">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button class="modelo-arrow next" aria-label="Seguinte" type="button">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>

          <span class="modelo-price" id="modelo-price-display">Desde €22.000</span>

          <!-- Typology Selector Overlay -->
          <div class="modelo-typology-selector">
            <button class="typology-pill active" data-index="0" type="button">T0</button>
            <button class="typology-pill" data-index="1" type="button">T1</button>
            <button class="typology-pill" data-index="2" type="button">T2</button>
            <button class="typology-pill" data-index="3" type="button">T3</button>
          </div>
        </div>
        <div class="modelo-body">
          <div class="modelo-name">
            <a href="/modelos/compact20" style="color:inherit; text-decoration:none; transition:color .3s;">Compact 20</a>
          </div>
          <p class="modelo-desc">A solução inteligente ideal para habitação permanente, anexo de jardim ou refúgio de campo. Montagem rápida em apenas 2 dias.</p>
          
          <div class="modelo-specs">
            <div class="spec">
              <span class="spec-label">Área Útil</span>
              <span class="spec-val">32 m²</span>
            </div>
            <div class="spec">
              <span class="spec-label">Tipologia</span>
              <span class="spec-val" id="card-tipologia-val">T0 a T3</span>
            </div>
            <div class="spec">
              <span class="spec-label">Instalação</span>
              <span class="spec-val">2 Dias</span>
            </div>
          </div>
          
          <div class="card-action-btns" style="display:flex; flex-direction:column; gap:0.5rem; width:100%;">
            <a href="#orcamento" class="modelo-link-btn featured-btn" style="width:100%;">Pedir Orçamento Compact 20</a>
            <a href="/modelos/compact20" class="modelo-link-btn featured-btn" style="width:100%; background:rgba(37, 99, 235, 0.12); border:1px solid var(--white); color:var(--white);">Ver Galeria & Detalhes →</a>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<script>
  const setupModelosSlider = () => {
    const card = document.querySelector('.modelo-card');
    if (!card) return;

    const slides = card.querySelectorAll('.modelo-slide');
    const pills = card.querySelectorAll('.typology-pill');
    const prevBtn = card.querySelector('.modelo-arrow.prev');
    const nextBtn = card.querySelector('.modelo-arrow.next');
    const priceDisplay = card.querySelector('#modelo-price-display');
    const tipologiaVal = card.querySelector('#card-tipologia-val');
    
    let currentIndex = 0;
    const totalSlides = slides.length;

    const updateSlider = (index: number) => {
      // Bounds check
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;
      currentIndex = index;

      // Update active slide
      slides.forEach((slide, idx) => {
        if (idx === currentIndex) {
          slide.classList.add('active');
        } else {
          slide.classList.remove('active');
        }
      });

      // Update active pill indicator
      pills.forEach((pill, idx) => {
        if (idx === currentIndex) {
          pill.classList.add('active');
        } else {
          pill.classList.remove('active');
        }
      });

      // Update price display
      const activeSlide = slides[currentIndex];
      if (activeSlide && priceDisplay) {
        const price = activeSlide.getAttribute('data-price');
        if (price) {
          priceDisplay.textContent = price;
        }
      }

      // Highlight selected typology in specs section
      if (tipologiaVal) {
        const typologies = ['T0 (Estúdio)', 'T1 (1 Quarto)', 'T2 (2 Quartos)', 'T3 (3 Quartos)'];
        tipologiaVal.textContent = typologies[currentIndex];
      }
    };

    // Pill click events
    pills.forEach((pill, idx) => {
      pill.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        updateSlider(idx);
      });
    });

    // Arrow click events
    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        updateSlider(currentIndex - 1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        updateSlider(currentIndex + 1);
      });
    }

    // Touch swipe gesture support
    let touchStartX = 0;
    let touchEndX = 0;
    const sliderContainer = card.querySelector('.modelo-slider-container');

    if (sliderContainer) {
      sliderContainer.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      sliderContainer.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        handleGesture();
      }, { passive: true });
    }

    const handleGesture = () => {
      const minDistance = 40; // minimum swipe distance
      if (touchStartX - touchEndX > minDistance) {
        // Swiped left -> Next slide
        updateSlider(currentIndex + 1);
      } else if (touchEndX - touchStartX > minDistance) {
        // Swiped right -> Previous slide
        updateSlider(currentIndex - 1);
      }
    };
  };

  // Run setup
  setupModelosSlider();
  // Support client-side navigation frameworks / page load transitions
  document.addEventListener('astro:page-load', setupModelosSlider);
</script>

