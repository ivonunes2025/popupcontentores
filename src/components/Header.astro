---
---
<nav id="navbar">
  <div class="nav-container">
    <a href="/" class="nav-logo" aria-label="KasaRápida Homepage">
      <svg class="brand-logo-svg" viewBox="0 0 200 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="topFace" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#93c5fd"/>
            <stop offset="100%" stop-color="#60a5fa"/>
          </linearGradient>
          <linearGradient id="rightFace" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#2563eb"/>
            <stop offset="100%" stop-color="#1d4ed8"/>
          </linearGradient>
          <linearGradient id="leftFace" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#3b82f6"/>
            <stop offset="100%" stop-color="#1d4ed8"/>
          </linearGradient>
        </defs>

        <!-- ICON: Isometric 3D Modular Cube forming 'K' (Architectural & Tech-Savvy) -->
        <g transform="translate(6, 4)">
          <!-- Top Face of the Cube -->
          <polygon points="18 4, 30 10, 18 16, 6 10" fill="url(#topFace)"/>
          
          <!-- Left Face of the Cube -->
          <polygon points="6 10, 18 16, 18 32, 6 26" fill="url(#leftFace)"/>
          
          <!-- Right Face of the Cube -->
          <polygon points="18 16, 30 10, 30 26, 18 32" fill="url(#rightFace)"/>
          
          <!-- An overlay speed arrow indicating "Rápida" that wraps around the cube -->
          <path d="M 5 20 L 18 27 L 31 20" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.9"/>
          
          <!-- Small tech dot connection at the apex -->
          <circle cx="18" cy="4" r="2" fill="#ffffff" />
        </g>

        <!-- TYPOGRAPHY: Elegant brand name -->
        <text x="48" y="30" font-family="'DM Sans', sans-serif" font-weight="800" font-size="20" fill="#ffffff" letter-spacing="0.5">Kasa<tspan fill="#2563eb">Rápida</tspan></text>
      </svg>
    </a>
    
    <ul class="nav-links">
      <li><a href="/#sobre">O que é</a></li>
      <li><a href="/#vantagens">Vantagens</a></li>
      <li><a href="/#modelos">Modelos</a></li>
      <li><a href="/#como">Como Funciona</a></li>
      <li><a href="/#faq">FAQ</a></li>
      <li><a href="/#orcamento" class="nav-cta">Pedir Orçamento</a></li>
    </ul>

    <button class="hamburger" id="hamburger-btn" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<div class="mobile-menu" id="mobileMenu">
  <div class="mobile-menu-links">
    <a href="/#sobre" class="mobile-link">O Que É</a>
    <a href="/#vantagens" class="mobile-link">Vantagens</a>
    <a href="/#modelos" class="mobile-link">Modelos</a>
    <a href="/#como" class="mobile-link">Como Funciona</a>
    <a href="/#faq" class="mobile-link">FAQ</a>
    <a href="/#orcamento" class="mobile-link mobile-cta">Pedir Orçamento</a>
  </div>
</div>



<script>
  const setupNavbar = () => {
    const navbar = document.getElementById('navbar');
    const hamburgerBtn = document.getElementById('hamburger-btn');
    const mobileMenu = document.getElementById('mobileMenu');
    const mobileLinks = document.querySelectorAll('.mobile-link');

    // Sticky Scroll Action
    const handleScroll = () => {
      if (window.scrollY > 50) {
        navbar?.classList.add('scrolled');
      } else {
        navbar?.classList.remove('scrolled');
      }
    };
    
    window.addEventListener('scroll', handleScroll);
    handleScroll(); // Initial check

    // Toggle menu
    const toggleMenu = () => {
      hamburgerBtn?.classList.toggle('active');
      mobileMenu?.classList.toggle('open');
      
      // Prevent body scroll when menu is open
      if (mobileMenu?.classList.contains('open')) {
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
      }
    };

    hamburgerBtn?.addEventListener('click', toggleMenu);

    // Close menu when links are clicked
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        hamburgerBtn?.classList.remove('active');
        mobileMenu?.classList.remove('open');
        document.body.style.overflow = '';
      });
    });
  };

  // Run on initial load
  setupNavbar();
  // Support Astro View Transitions if used in future
  document.addEventListener('astro:page-load', setupNavbar);
</script>
