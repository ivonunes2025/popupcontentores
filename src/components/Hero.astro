---
---
<section class="hero" id="hero">
  <div class="hero-grid"></div>
  <div class="hero-glow"></div>

  <div class="hero-container">
    <div class="hero-content">
      <div class="hero-tag">Smart Home · Portugal</div>
      <h1>Transporta.<br>Abre.<br><em>Habita.</em></h1>
      <p class="hero-sub">Casas expansíveis modernas, prontas a habitar em poucas horas. Solução modular rápida, sofisticada e sustentável para qualquer terreno em Portugal.</p>
      
      <div class="hero-actions">
        <a href="#orcamento" class="btn-primary">Pedir Orçamento Grátis</a>
        <a href="#modelos" class="btn-ghost">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          Ver Modelos
        </a>
      </div>

      <!-- Quick Trust Badges -->
      <div class="hero-badges">
        <div class="badge-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--copper)" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          <span>Instalação em 4 Horas</span>
        </div>
        <div class="badge-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--copper)" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          <span>Até 60% Mais Económico</span>
        </div>
      </div>
    </div>

    <!-- Right Side: Luxury Image Slider/Showcase -->
    <div class="hero-visual">
      <div class="slider-wrapper">
        <div class="slides">
          <!-- Slide 1 -->
          <div class="slide active">
            <img src="/1.jpeg" alt="KasaRápida Casa Expansível Compact 20" class="hero-img" />
            <div class="slide-overlay">
              <span class="slide-tag">Compact 20</span>
              <span class="slide-meta">Ideal para estúdios e escritórios</span>
            </div>
          </div>
          <!-- Slide 2 -->
          <div class="slide">
            <img src="/2.jpeg" alt="KasaRápida Casa Dobrável Duplex 40" class="hero-img" />
            <div class="slide-overlay">
              <span class="slide-tag">Duplex 40</span>
              <span class="slide-meta">Casas de banho e quartos integrados</span>
            </div>
          </div>
          <!-- Slide 3 -->
          <div class="slide">
            <img src="/3.jpeg" alt="KasaRápida Casa Modular Villa 60" class="hero-img" />
            <div class="slide-overlay">
              <span class="slide-tag">Villa 60</span>
              <span class="slide-meta">Construção modular de luxo familiar</span>
            </div>
          </div>
        </div>

        <!-- Slider Navigation -->
        <div class="slider-nav">
          <button class="nav-dot active" aria-label="Slide 1"></button>
          <button class="nav-dot" aria-label="Slide 2"></button>
          <button class="nav-dot" aria-label="Slide 3"></button>
        </div>
      </div>

      <div class="visual-glow"></div>
    </div>
  </div>

</section>


<script>
  const setupHeroSlider = () => {
    const slides = document.querySelectorAll('.slide');
    const dots = document.querySelectorAll('.nav-dot');
    let currentSlide = 0;
    let slideInterval: NodeJS.Timeout;

    const showSlide = (index: number) => {
      slides.forEach(s => s.classList.remove('active'));
      dots.forEach(d => d.classList.remove('active'));
      
      slides[index].classList.add('active');
      dots[index].classList.add('active');
      currentSlide = index;
    };

    const nextSlide = () => {
      let next = currentSlide + 1;
      if (next >= slides.length) next = 0;
      showSlide(next);
    };

    const startSlider = () => {
      stopSlider();
      slideInterval = setInterval(nextSlide, 5000);
    };

    const stopSlider = () => {
      if (slideInterval) clearInterval(slideInterval);
    };

    // Dot click events
    dots.forEach((dot, idx) => {
      dot.addEventListener('click', () => {
        showSlide(idx);
        startSlider(); // reset timer
      });
    });

    startSlider();
  };

  // Run on initial load
  setupHeroSlider();
  // Support Astro View Transitions if used in future
  document.addEventListener('astro:page-load', setupHeroSlider);
</script>
