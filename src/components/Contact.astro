---
---
<section class="cta-final" id="orcamento">
  <div class="cta-bg-text">KASARÁPIDA</div>
  
  <div class="cta-final-inner">
    <div class="reveal">
      <div class="section-label" style="justify-content:center">Faça a sua Escolha</div>
      <h2 class="section-title">Pronto para<br><em style="color:var(--copper);font-style:normal">Começar?</em></h2>
      <p class="section-body" style="margin:1rem auto 0; text-align:center; max-width: 520px;">
        Receba um orçamento detalhado e totalmente personalizado para o seu terreno, de forma 100% gratuita. Respondemos em menos de 24 horas.
      </p>
    </div>

    <!-- Contact Form with Glassmorphism -->
    <form class="cta-form reveal" style="transition-delay:.1s" id="contact-form">
      <div class="form-grid">
        <div class="input-group">
          <input type="text" id="name" required placeholder=" " />
          <label for="name">O seu nome</label>
        </div>
        <div class="input-group">
          <input type="tel" id="phone" required placeholder=" " />
          <label for="phone">Telemóvel / WhatsApp</label>
        </div>
        <div class="input-group full-width">
          <input type="email" id="email" required placeholder=" " />
          <label for="email">Endereço de Email</label>
        </div>
      </div>
      
      <button type="submit" class="btn-primary form-submit">
        <span>Enviar Pedido de Orçamento →</span>
      </button>
    </form>

    <!-- Success Feedback Overlay (Hidden by Default) -->
    <div class="success-message" id="success-feedback">
      <div class="success-icon">✓</div>
      <h3>Pedido Recebido!</h3>
      <p>Entraremos em contacto consigo através do telemóvel ou email indicado nas próximas horas.</p>
    </div>

    <!-- Details Grid -->
    <div class="contact-details reveal" style="transition-delay:.15s">
      <div class="detail-card">
        <div class="detail-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--copper)" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
        </div>
        <div class="detail-title">WhatsApp / Chamada</div>
        <a href="tel:+351910000000" class="detail-link">+351 910 000 000</a>
      </div>
      
      <div class="detail-divider"></div>
      
      <div class="detail-card">
        <div class="detail-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--copper)" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </div>
        <div class="detail-title">Email</div>
        <a href="mailto:info@kasarapida.pt" class="detail-link">info@kasarapida.pt</a>
      </div>
      
      <div class="detail-divider"></div>
      
      <div class="detail-card">
        <div class="detail-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--copper)" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        </div>
        <div class="detail-title">Horário de Apoio</div>
        <span class="detail-text">Segunda a Sexta · 9h às 19h</span>
      </div>
    </div>
  </div>
</section>



<script>
  const setupContactForm = () => {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successFeedback = document.getElementById('success-feedback');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      
      // Simulate form submission
      form.classList.add('hidden');
      if (successFeedback) {
        successFeedback.classList.add('visible');
      }
    });
  };

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
