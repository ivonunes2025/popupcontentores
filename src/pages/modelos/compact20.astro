---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="KasaRápida — Modelo Compact 20 (Expandível)" description="Explore as especificações completas, galeria de fotos de alta qualidade e detalhes da nossa casa expansível Compact 20.">
  <Header />

  <main class="model-detail-page">
    
    <!-- Hero Header Section -->
    <section class="model-hero">
      <div class="model-hero-glow"></div>
      <div class="model-hero-inner">
        <div class="model-hero-content">
          <a href="/" class="back-link">← Voltar à Página Inicial</a>
          <span class="section-label">Habitação Expansível Avançada</span>
          <h1 class="model-title">KasaRápida<br><span class="accent-text">Compact 20</span></h1>
          <p class="model-lead">
            A Compact 20 representa o pico da engenharia de casas dobráveis inteligentes. Transportada de forma ultracompacta, abre-se em minutos no terreno para revelar uma habitação moderna, elegante e totalmente equipada de 32 m² de área útil.
          </p>
          <div class="quick-meta-grid">
            <div class="meta-item">
              <span class="meta-num">32 m²</span>
              <span class="meta-txt">Área Útil Total</span>
            </div>
            <div class="meta-item">
              <span class="meta-num">T0 a T3</span>
              <span class="meta-txt">Tipologia Flexível</span>
            </div>
            <div class="meta-item">
              <span class="meta-num">A+</span>
              <span class="meta-txt">Classe Energética</span>
            </div>
          </div>
          <div class="hero-actions">
            <a href="/contacto" class="btn-primary">Pedir Orçamento Compact 20</a>
          </div>
        </div>
        
        <div class="model-hero-media">
          <div class="main-media-card">
            <img src="/1.jpeg" alt="KasaRápida Compact 20 Vista Principal" id="main-gallery-view" class="main-preview-img" />
            <div class="media-caption" id="media-caption-text">Compact 20 (Ângulo A) — Design arquitetónico minimalista com acabamento termo-lacado moderno.</div>
          </div>
          <div class="media-thumbnails">
            <button class="thumb-btn active" data-src="/1.jpeg" data-caption="Compact 20 (Ângulo A) — Design arquitetónico minimalista com acabamento termo-lacado moderno.">
              <img src="/1.jpeg" alt="Compact 20 Vista Principal" />
              <span>Ângulo Principal</span>
            </button>
            <button class="thumb-btn" data-src="/2.jpeg" data-caption="Compact 20 (Ângulo B) — Acabamentos antracite refinados e janelas panorâmicas com isolamento de dupla vidragem.">
              <img src="/2.jpeg" alt="Compact 20 Vista Alternativa" />
              <span>Ângulo Lateral</span>
            </button>
            <button class="thumb-btn" data-src="/int2.jpg" data-caption="Interior Compact 20 — Sala de estar contemporânea com painel de TV, iluminação LED quente e plantas decorativas.">
              <img src="/int2.jpg" alt="Compact 20 Sala de Estar" />
              <span>Sala de Estar</span>
            </button>
            <button class="thumb-btn" data-src="/int1.jpg" data-caption="Interior Compact 20 — Cozinha integrada com mesa de jantar funcional e persianas de madeira acolhedoras.">
              <img src="/int1.jpg" alt="Compact 20 Cozinha e Jantar" />
              <span>Cozinha & Jantar</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Detailed Specifications -->
    <section class="model-specs-section">
      <div class="specs-inner">
        <div class="section-header-centered">
          <span class="section-label">Especificações Técnicas</span>
          <h2 class="section-title">Ficha Técnica Detalhada</h2>
          <p class="section-body">
            Conheça todos os detalhes construtivos, materiais estruturais e isolamento de alta performance que tornam a Compact 20 líder em durabilidade e conforto.
          </p>
        </div>

        <div class="specs-pane-grid">
          <div class="specs-list-card">
            <h3>Resumo do Modelo</h3>
            <ul class="detail-specs-list">
              <li><strong>Área Útil Real:</strong> 32 m² (aproximadamente 5.9m largura x 5.4m profundidade expandido)</li>
              <li><strong>Dimensão Dobrada:</strong> 5.9m x 2.2m x 2.5m (transportada com toda a segurança pela nossa equipa)</li>
              <li><strong>Tipologias de Layout:</strong> Altamente flexível, com partições modulares desde Estúdio T0 até configuração T3 com 3 quartos independentes e WC completo</li>
              <li><strong>Preço Chave-na-Mão:</strong> Desde €22.000 (transporte 100% por nossa conta e montagem rápida incluídos)</li>
              <li><strong>Tempo de Instalação:</strong> Cerca de 2 dias para ficar 100% pronta e habitável</li>
              <li><strong>Vida Útil Estimada:</strong> Superior a 50 anos com aço estrutural galvanizado</li>
            </ul>
          </div>
          
          <div class="specs-table-card">
            <h3>Especificações de Engenharia</h3>
            <table class="specs-table">
              <tr>
                <th>Estrutura Principal</th>
                <td>Aço estrutural galvanizado Q235B com pintura epóxi anticorrosiva de alta aderência</td>
              </tr>
              <tr>
                <th>Isolamento Térmico</th>
                <td>Painéis sanduíche de 75mm em Poliuretano (PU) de alta densidade (40 kg/m³), corta-fogo</td>
              </tr>
              <tr>
                <th>Caixilharia & Vidros</th>
                <td>Alumínio com rutura térmica premium lacado a cinza antracite, vidro duplo temperado 5+12A+5</td>
              </tr>
              <tr>
                <th>Pavimento Integrado</th>
                <td>Base estrutural de fibrocimento hidrófugo 18mm com piso laminado vinílico flutuante antiderrapante</td>
              </tr>
              <tr>
                <th>Rede Elétrica e Águas</th>
                <td>Quadro elétrico geral integrado, cablagens embutidas anti-chama e canalização multicamada pronta</td>
              </tr>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Detailed Finishing and Photos Gallery -->
    <section class="model-gallery-section">
      <div class="gallery-inner">
        <div class="section-header-centered">
          <span class="section-label">Galeria de Inspiração</span>
          <h2 class="section-title">Fotos Reais do Modelo & Acabamentos</h2>
          <p class="section-body">
            Ambas as fotos exteriores representam o mesmo modelo Compact 20, demonstrando a versatilidade de ângulos e a integração de acabamentos de luxo nas casas de banho e cozinha.
          </p>
        </div>

        <div class="model-photo-grid">
          <div class="photo-item zoomable">
            <img src="/1.jpeg" alt="Compact 20 — Vista Principal de Frente" />
            <div class="photo-meta">
              <h4>Compact 20 — Fachada Principal</h4>
              <p>Vista frontal ampla mostrando o design simétrico expansível e a porta de acesso térmico.</p>
            </div>
          </div>
          
          <div class="photo-item zoomable">
            <img src="/2.jpeg" alt="Compact 20 — Vista Tridimensional de Ângulo" />
            <div class="photo-meta">
              <h4>Compact 20 — Ângulo Tridimensional</h4>
              <p>Demonstração da profundidade da casa expandida com acabamentos pretos minimalistas.</p>
            </div>
          </div>

          <div class="photo-item zoomable">
            <img src="/int2.jpg" alt="Compact 20 — Sala de Estar e TV" />
            <div class="photo-meta">
              <h4>Sala de Estar Moderna</h4>
              <p>Ambiente aconchegante open-space projetado para o máximo aproveitamento de luz natural e conforto.</p>
            </div>
          </div>

          <div class="photo-item zoomable">
            <img src="/int1.jpg" alt="Compact 20 — Cozinha e Sala de Jantar" />
            <div class="photo-meta">
              <h4>Cozinha & Zona de Refeições</h4>
              <p>Espaço integrado e funcional com acabamentos contemporâneos e persianas de madeira elegantes.</p>
            </div>
          </div>

          <div class="photo-item zoomable">
            <img src="/cb1.jpeg" alt="Cozinha Integrada Premium KasaRápida" />
            <div class="photo-meta">
              <h4>Cozinha Premium open-space</h4>
              <p>Móveis lacados minimalistas e arrumação sob medida incluídos de fábrica no modelo.</p>
            </div>
          </div>

          <div class="photo-item zoomable">
            <img src="/cb2.jpeg" alt="Casa de Banho Mármore Modern Light KasaRápida" />
            <div class="photo-meta">
              <h4>Casa de Banho Mármore Modern</h4>
              <p>Acabamentos marmoreados suspensos e iluminação LED embutida incluídos de série.</p>
            </div>
          </div>
          
          <div class="photo-item zoomable">
            <img src="/cb3.jpeg" alt="Casa de Banho Luxuosa Gold Rain KasaRápida" />
            <div class="photo-meta">
              <h4>Casa de Banho Mármore Gold</h4>
              <p>Detalhes modernos com veios dourados e louça sanitária suspensa de alta gama.</p>
            </div>
          </div>
          
          <div class="photo-item zoomable">
            <img src="/cb4.jpeg" alt="Casa de Banho Compacta Elegante" />
            <div class="photo-meta">
              <h4>Duche Curved Elegance</h4>
              <p>Cabine de duche de canto semicircular otimizada com perfis em preto mate.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Deep Tech Information (How it Works / Shipping) -->
    <section class="model-features-deep">
      <div class="deep-inner">
        <div class="specs-pane-grid">
          <div class="deep-text-card">
            <span class="section-label">Construção Robusta</span>
            <h2>Tecnologia Construtiva</h2>
            <p>
              A estrutura principal da Compact 20 é composta por perfis de aço estrutural Q235B galvanizado a quente. Todo o aço passa por um processo de pintura eletrostática a pó com cura em forno de alta temperatura, resultando numa carcaça ultra-resistente à oxidação marinha e humidade, com durabilidade estimada de **mais de 50 anos**.
            </p>
            <p>
              As paredes térmicas utilizam painéis sanduíche contínuos de 75mm em Poliuretano (PU) expandido de altíssima densidade. Isto assegura que a casa isole o calor do verão e retenha o aquecimento no inverno, garantindo uma eficiência climatérica excepcional de classe energética **A+** em todo o território nacional.
            </p>
          </div>
          
          <div class="deep-text-card">
            <span class="section-label">Transporte e Logística</span>
            <h2>Logística e Montagem Rápida</h2>
            <p>
              O transporte é totalmente assegurado pela nossa equipa e por nossa conta, sem qualquer custo adicional ou preocupação para si. A Compact 20 é transportada completamente fechada e compacta, com uma largura de apenas 2.2 metros. Isto permite-nos levá-la até ao seu terreno usando camiões normais de carga padrão, reduzindo drasticamente custos e burocracias com licenças de transporte especial.
            </p>
            <p>
              Ao chegar ao local, a casa é suspensa e assentada em fundações leves (como sapatas ou blocos simples). O processo de desdobramento assistido por guinchos leva menos de uma hora, e a equipa técnica da KasaRápida executa a fixação estanque dos painéis, a colocação de calhas e a ligação de infraestruturas em **apenas 2 dias**.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Model Extras & Personalizations Section -->
    <section class="model-extras-section">
      <div class="extras-inner">
        <div class="section-header-centered">
          <span class="section-label">Módulos & Configurações</span>
          <h2 class="section-title">Extras & Personalizações</h2>
          <p class="section-body">
            Esqueça as limitações de espaço. Configure a sua KasaRápida adicionando decks, coberturas e escolhendo acabamentos sanitários de gama alta.
          </p>
        </div>

        <div class="extras-grid">
          <!-- Extra 1: Cobertura Automóvel -->
          <div class="extra-card">
            <span class="extra-icon">🚗</span>
            <h3 class="extra-title">Cobertura para Automóvel</h3>
            <p class="extra-desc">Estrutura metálica de alta resistência integrada em aço galvanizado e painel sanduíche para proteção de intempéries, acoplável nas laterais.</p>
          </div>

          <!-- Extra 2: Deck Frontal -->
          <div class="extra-card">
            <span class="extra-icon">🏡</span>
            <h3 class="extra-title">Deck Frontal de Madeira</h3>
            <p class="extra-desc">Um terraço exterior plano em pinho nórdico tratado ou composto WPC de baixa manutenção, criando um espaço exterior perfeito para convívio.</p>
          </div>

          <!-- Extra 3: Deck Superior (Rooftop) -->
          <div class="extra-card">
            <span class="extra-icon">⛰️</span>
            <h3 class="extra-title">Deck Superior (Rooftop)</h3>
            <p class="extra-desc">Aproveite a cobertura da sua casa. Criamos um terraço panorâmico no topo com escadas de acesso seguras e guardas protetoras em metal ou vidro.</p>
          </div>

          <!-- Extra 4: WC Personalizados -->
          <div class="extra-card">
            <span class="extra-icon">🚿</span>
            <h3 class="extra-title">WCs Personalizáveis</h3>
            <p class="extra-desc">Configure a sua casa de banho com qualquer uma das 4 opções de mármores luxuosos, divisórias de vidro temperado e torneiras modernas de topo.</p>
          </div>

          <!-- Extra 5: Cozinha open-space -->
          <div class="extra-card">
            <span class="extra-icon">🍳</span>
            <h3 class="extra-title">Cozinhas Inteligentes</h3>
            <p class="extra-desc">Móveis open-space desenhados sob medida com arrumação inteligente, bancada em pedra composta e torneiras monocomando flexíveis.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- What is Included List -->
    <section class="included-section">
      <div class="included-inner">
        <h2 class="section-title text-center">O Que Está Incluído no Preço Chave-na-Mão?</h2>
        <p class="section-body text-center">
          Entregamos a habitação totalmente equipada no interior e pronta a habitar. Sem custos ocultos.
        </p>
        
        <div class="included-grid">
          <div class="included-card">
            <div class="inc-icon">✓</div>
            <h4>Montagem e Nivelamento</h4>
            <p>Içamento e montagem completa da estrutura no seu terreno, incluindo calhas pluviais e isolamento de eixos.</p>
          </div>
          <div class="included-card">
            <div class="inc-icon">✓</div>
            <h4>Cozinha Equipada</h4>
            <p>Móveis inferiores e suspensos lacados, bancada em pedra composta sintética e lava-loiça duplo com torneira flexível.</p>
          </div>
          <div class="included-card">
            <div class="inc-icon">✓</div>
            <h4>Casa de Banho Completa</h4>
            <p>Sanita suspensa embutida, lavatório moderno com móvel flutuante, espelho LED e cabine de duche em vidro temperado.</p>
          </div>
          <div class="included-card">
            <div class="inc-icon">✓</div>
            <h4>Instalação Elétrica Pronta</h4>
            <p>Quadro elétrico geral, fiação anti-chama interna, tomadas de padrão europeu e focos LED embutidos em todo o teto.</p>
          </div>
          <div class="included-card">
            <div class="inc-icon">✓</div>
            <h4>Canalização e Esgotos</h4>
            <p>Rede de águas limpas em multicamada e águas residuais pré-instaladas, centralizadas numa única saída exterior.</p>
          </div>
          <div class="included-card">
            <div class="inc-icon">✓</div>
            <h4>Pavimento Vinílico Click</h4>
            <p>Chão flutuante vinílico de alta durabilidade e isolamento acústico em toda a habitação, incluindo rodapés.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA Section -->
    <section class="model-cta-bottom">
      <div class="cta-inner reveal">
        <h2>Pronto para Ter a Sua KasaRápida?</h2>
        <p>Peça hoje um orçamento gratuito chave-na-mão para a Compact 20. Fabricamos e entregamos no seu terreno em Portugal Continental.</p>
        <div class="cta-btns">
          <a href="/#orcamento" class="btn-primary">Pedir Orçamento Compact 20</a>
          <a href="/#modelos" class="btn-secondary">Voltar ao Catálogo</a>
        </div>
      </div>
    </section>

    <!-- Page Lightbox Modal -->
    <div class="wc-lightbox" id="model-lightbox">
      <span class="lightbox-close" id="model-lightbox-close">&times;</span>
      <img class="lightbox-content" id="model-lightbox-img" src="" alt="" />
      <div id="model-lightbox-caption"></div>
    </div>

  </main>

  <Footer />
</Layout>

<script>
  const setupModelPage = () => {
    // 1. Hero gallery preview switcher
    const mainView = document.getElementById('main-gallery-view') as HTMLImageElement;
    const captionText = document.getElementById('media-caption-text');
    const thumbBtns = document.querySelectorAll('.thumb-btn');

    thumbBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-src');
        const caption = btn.getAttribute('data-caption');
        
        if (mainView && src) {
          mainView.src = src;
        }
        if (captionText && caption) {
          captionText.textContent = caption;
        }

        thumbBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      });
    });

    // 2. Zoomable Gallery Lightbox
    const lightbox = document.getElementById('model-lightbox');
    const lightboxImg = document.getElementById('model-lightbox-img') as HTMLImageElement;
    const lightboxCaption = document.getElementById('model-lightbox-caption');
    const closeBtn = document.getElementById('model-lightbox-close');
    const zoomableImages = document.querySelectorAll('.photo-item img');

    zoomableImages.forEach(img => {
      img.addEventListener('click', () => {
        if (lightbox && lightboxImg) {
          lightbox.classList.add('open');
          const element = img as HTMLImageElement;
          lightboxImg.src = element.src;
          
          // Get the caption description from neighboring .photo-meta
          const meta = element.nextElementSibling;
          if (lightboxCaption && meta) {
            const h4 = meta.querySelector('h4')?.textContent || '';
            const p = meta.querySelector('p')?.textContent || '';
            lightboxCaption.textContent = `${h4} — ${p}`;
          } else if (lightboxCaption) {
            lightboxCaption.textContent = element.alt;
          }
        }
      });
    });

    closeBtn?.addEventListener('click', () => {
      lightbox?.classList.remove('open');
    });

    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        lightbox?.classList.remove('open');
      }
    });
  };

  setupModelPage();
  document.addEventListener('astro:page-load', setupModelPage);
</script>
