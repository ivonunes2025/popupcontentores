  <Header />
  
  <main>
    <!-- HERO SECTION -->
    <Hero />

    <!-- STATS QUICK LOOK -->
    <Stats />

    <!-- FEATURED SIGNATURE MODEL SPOTLIGHT -->
    <Modelos />

    <!-- CONTACT FORM SECTION -->
    <Contact />
  </main>
  
  <Footer />
</Layout>
